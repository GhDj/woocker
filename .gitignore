# Environment files
.env

# SSL Certificates (locally generated)
ssl/

# Docker volumes
db_data/

# IDE and editor files (but keep .vscode/launch.json)
.idea/
*.swp
*.swo
*~
.DS_Store

# Composer
vendor/
composer.lock

# PHPUnit
.phpunit.result.cache
coverage-html/
tests-output/
phpunit.xml.dist

# WordPress - ignore everything except custom plugins
# Old structure (deprecated but kept for history if needed)
wordpress/

# New Multi-Instance Structure
instances/
!instances/.gitkeep

# Shared Plugins - Track these!
plugins/
!plugins/.gitkeep
# Ignore everything inside plugins except specific ones if needed, 
# but usually we want to track shared plugins.
# If you want to ignore specific plugins, add them here.

# Logs
*.log
logs/
*.sql
*.sqlite

# Temporary files
tmp/
temp/
*.tmp

# Node modules (if you use npm/yarn)
node_modules/
package-lock.json
yarn.lock

# Build files
dist/
build/

# OS files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
._*
